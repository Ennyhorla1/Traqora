{
  "name": "traqora",
  "version": "0.1.0",
  "description": "Traqora - Stellar blockchain travel booking platform",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:contributing": "node scripts/lint-contributing.js",
    "test:contributing": "jest scripts/__tests__/lint-contributing.test.js",
    "lint:pr-template": "node scripts/lint-pr-template.js",
    "test:pr-template": "jest scripts/__tests__/lint-pr-template.test.js",
    "typecheck": "npm run typecheck --workspaces",
    "test:scripts": "bash scripts/tests/network-guard.test.sh",
    "check:env-drift": "node scripts/check-backend-env-drift.js --example env.example",
    "check:migrations": "node scripts/check-migration-zero-downtime.js",
    "db:backup": "node scripts/db-backup-restore.js backup",
    "db:restore": "node scripts/db-backup-restore.js restore",
    "test:env-drift": "jest scripts/__tests__/check-backend-env-drift.test.js",
    "test:migrations-policy": "jest scripts/__tests__/check-migration-zero-downtime.test.js",
    "test:backup-restore": "jest scripts/__tests__/db-backup-restore.test.js",
    "clean": "npm run clean --workspaces"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^8.57.0",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bs-logger": "^0.2.6",
    "buffer-equal-constant-time": "^1.0.1",
    "ecdsa-sig-formatter": "^1.0.11",
    "exit": "^0.1.2",
    "safe-buffer": "^5.2.1",
    "semver": "^7.8.5",
    "source-map": "^0.8.0",
    "source-map-support": "^0.5.21"
  }
}
